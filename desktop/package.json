{
  "name": "appsend",
  "version": "1.6.0",
  "private": true,
  "description": "Encrypted local network edge transfers",
  "author": "AppSEND contributors",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "dependencies": {
    "mime-types": "3.0.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.appsend.desktop",
    "productName": "AppSEND",
    "files": [
      "*.cjs",
      "ui/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "AppSEND discovers nearby devices and transfers files directly over your local network."
      },
      "identity": "-"
    }
  }
}
